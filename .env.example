# MORNINGSTAR / LA MAIN DE DIEU — copy to .env
# cp .env.example .env

# Owner phone(s), country code, no +. Required for system log group.
OWNER_NUMBER=225XXXXXXXXX

# Extra privileged numbers (comma-separated)
# SUDO=225XXXXXXXXX

# First-boot seeds only
BOT_MODE=public
BOT_LANG=en

# Session (multi-file, Termux-safe)
SESSION_DIR=./session
KV_PATH=./data/botkv.json

# Pairing-code login instead of QR (digits, country code)
# PAIRING_NUMBER=225XXXXXXXXX

STICKER_PACKNAME=MORNINGSTAR
STICKER_AUTHOR=ELOHIM — THE ETERNAL

# Optional remove.bg API key for #removebg
# REMOVEBG_API_KEY=

LOG_LEVEL=warn
BAILEYS_LOG_LEVEL=silent

JOB_CONCURRENCY=1
ERROR_ALERT_THRESHOLD=8
TENANT_ID=default

# Optional ops HTTP (off by default)
# ADMIN_HTTP_PORT=8787
# ADMIN_HTTP_HOST=127.0.0.1
# ADMIN_HTTP_TOKEN=change-me-to-a-long-secret
